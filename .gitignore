# macOS specific
.DS_Store

# Data payloads and local download caches.
# Keep the documented directory scaffold and .gitkeep files visible on GitHub.
data/**/*.csv
data/**/*.json
data/**/*.parquet
data/**/*.zip
data/**/*.txt
data/**/*.png
data/**/*.log
data/**/*.metadata
data/**/*.lock
data/**/.cache/
data/**/.DS_Store
data/**/TAG
!data/**/.gitkeep
!data/**/*.md

# Python specific
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
venv/
.env

# LaTeX specific
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
*.bbl
*.blg
*.dvi
*.pdf

# Notes LaTeX specific
notes/*.aux
notes/*.log
notes/*.out
notes/*.fls
notes/*.fdb_latexmk
notes/*.synctex.gz
notes/*.pdf

# Experimental outputs
results/main/**/*.json
results/ablation/**/*.json
results/baselines/**/*.json
results/sensitivity/**/*.json
results/analysis/**/*.json
results/debug/**

# Legacy result structure
results/metrics/**/*.json
results/final_summary.json
results/final_summary_*.json

# Generated figures (修論用にGit管理したいならignoreしない)
results/figures/**/*.png
results/figures/**/*.jpg
results/figures/**/*.jpeg
results/figures/**/*.pdf
results/figures/**/*.svg

# Keep directory structure
!results/**/.gitkeep
